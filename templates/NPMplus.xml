<?xml version="1.0" encoding="utf-8"?>
<Container version="2">
  <Name>NPMplus</Name>
  <Repository>zoeyvid/npmplus:latest</Repository>
  <Registry>https://hub.docker.com/r/zoeyvid/npmplus</Registry>
  <Network>bridge</Network>
  <MyIP />
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/ZoeyVid/NPMplus/issues</Support>
  <Project>https://github.com/ZoeyVid/NPMplus</Project>
  <ReadMe>https://github.com/ZoeyVid/NPMplus#readme</ReadMe>
  <Overview>NPMplus is an improved fork of Nginx Proxy Manager. This Unraid template provides a ready-to-use bridge-mode setup with grouped variables for ports, ACME, nginx/TLS, GoAccess, PHP, OIDC/auth-request and optional external MariaDB. Review the port mappings before first start, especially if the Unraid WebUI already uses ports 80 or 443.</Overview>
  <Category>Network:Proxy:Web</Category>
  <WebUI>http://[IP]:[PORT:81]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/Railline/unraid-community-apps/main/templates/NPMplus.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/Railline/unraid-community-apps/main/assets/npmplus.png</Icon>
  <ExtraParams>--security-opt=no-new-privileges:true</ExtraParams>
  <PostArgs />
  <CPUset />
  <DateInstalled></DateInstalled>
  <DonateText />
  <DonateLink />
  <Requires />
  <TailscaleStateDir />
  <Config Name="Paths - Data" Target="/data" Default="/mnt/user/appdata/npmplus" Mode="rw" Description="Persistent NPMplus data, certificates, nginx configuration and database files when SQLite is used." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/npmplus</Config>
  <Config Name="Paths - Web root" Target="/var/www" Default="/mnt/user/appdata/npmplus/www" Mode="rw" Description="Optional web root if you want NPMplus to serve static HTML/PHP content directly." Type="Path" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Paths - GoAccess GeoIP DB" Target="/opt/npmplus/goaccess/geoip" Default="/mnt/user/appdata/npmplus/goaccess/geoip" Mode="rw" Description="Optional GeoIP database directory for GoAccess. Put MaxMind GeoLite2 files here if GOA is enabled." Type="Path" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Core - TZ" Target="TZ" Default="Etc/UTC" Mode="" Description="Timezone, for example Europe/Paris or America/New_York." Type="Variable" Display="always" Required="true" Mask="false">Etc/UTC</Config>
  <Config Name="Core - ENABLE_PRERUN" Target="ENABLE_PRERUN" Default="false" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Core - PUID" Target="PUID" Default="99" Mode="" Description="Unraid nobody user id. Use 0 only if you know why you need root inside the container." Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="Core - PGID" Target="PGID" Default="100" Mode="" Description="Unraid users group id." Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="Core - DISABLE_GRAVATAR" Target="DISABLE_GRAVATAR" Default="true" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
  <Config Name="Core - COOKIE_SECRET" Target="COOKIE_SECRET" Default="some-random-string" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Ports - NPM_PORT" Target="NPM_PORT" Default="81" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">81</Config>
  <Config Name="Ports - NPM UI host port" Target="81" Default="81" Mode="tcp" Description="Host port for the NPMplus web interface." Type="Port" Display="always" Required="true" Mask="false">81</Config>
  <Config Name="Ports - GOA_PORT" Target="GOA_PORT" Default="91" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">91</Config>
  <Config Name="Ports - GoAccess host port" Target="91" Default="91" Mode="tcp" Description="Host port for GoAccess. Keep equal to GOA_PORT unless you know why you need a different mapping." Type="Port" Display="always" Required="false" Mask="false">91</Config>
  <Config Name="Ports - HTTP_PORT" Target="HTTP_PORT" Default="8080" Mode="" Description="Internal HTTP port used by NPMplus. Host port below maps to this container port." Type="Variable" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Ports - HTTP host port" Target="8080" Default="80" Mode="tcp" Description="Host port for HTTP traffic. Change this if Unraid already uses port 80." Type="Port" Display="always" Required="true" Mask="false">80</Config>
  <Config Name="Ports - HTTPS_PORT" Target="HTTPS_PORT" Default="8443" Mode="" Description="Internal HTTPS port used by NPMplus. Host ports below map to this container port." Type="Variable" Display="always" Required="true" Mask="false">8443</Config>
  <Config Name="Ports - HTTPS host port TCP" Target="8443" Default="443" Mode="tcp" Description="Host port for HTTPS traffic. Change this if Unraid already uses port 443." Type="Port" Display="always" Required="true" Mask="false">443</Config>
  <Config Name="Ports - HTTPS host port UDP" Target="8443" Default="443" Mode="udp" Description="This is just the port binding for HTTPS_PORT if u are in bridge mode, this need to be = to HTTPS_PORT Port Config" Type="Port" Display="always" Required="true" Mask="false">443</Config>
  <Config Name="Ports / bind - IPV4_BINDING" Target="IPV4_BINDING" Default="0.0.0.0" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">0.0.0.0</Config>
  <Config Name="Ports / bind - NPM_IPV4_BINDING" Target="NPM_IPV4_BINDING" Default="0.0.0.0" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">0.0.0.0</Config>
  <Config Name="Ports / bind - GOA_IPV4_BINDING" Target="GOA_IPV4_BINDING" Default="0.0.0.0" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">0.0.0.0</Config>
