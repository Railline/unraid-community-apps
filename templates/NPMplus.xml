  <Config Name="Ports / bind - GOA_LISTEN_LOCALHOST" Target="GOA_LISTEN_LOCALHOST" Default="false" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">false</Config>
  <Config Name="Ports / bind - DISABLE_HTTP" Target="DISABLE_HTTP" Default="false" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">false</Config>
