B64_PHP
chmod 644 "${WEB_DIR}/include/CrowdSecUnraidBouncer.php"

if [ ! -f "${BOOT_DIR}/config.cfg" ]; then
  cat > "${BOOT_DIR}/config.cfg" <<'CFG'
ENABLED="yes"
CS_CONTAINER="crowdsec"
LAPI_URL="http://127.0.0.1:8082"
LAPI_STREAM_TIMEOUT="300"
API_KEY=""
CS_CHAIN="CROWDSEC"
IPTABLES_CHAINS="INPUT DOCKER-USER"
UPDATE_INTERVAL="10"
FULL_SYNC_INTERVAL="900"
LOG_LEVEL="info"
SKIP_PRIVATE_IPV4="yes"
STREAM_ORIGINS="crowdsec,cscli"
MAX_DIRECT_RULES="5000"
PROTECTION_MODE="essential"
FIREWALL_BACKEND="auto"
IPSET_NAME="crowdsec4"
HEALTH_MAX_SYNC_AGE="900"
HEALTH_MIN_IPSET_ENTRIES="0"
TELEGRAM_HTTP_CONFIG="/mnt/cache/appdata/crowdsec/notifications/http.yaml"
NOTIFY_COOLDOWN="1800"
NOTIFY_TELEGRAM="yes"
NOTIFY_UNRAID="yes"
NOTIFY_ENABLED="yes"
CFG
else
  CONFIG_TMP="$(mktemp "${BOOT_DIR}/config.cfg.XXXXXX")"
  trap 'rm -f "$CONFIG_TMP"' EXIT
  sed -E '/^(CTM_DROPS_[A-Z_]*|DECISION_LIMIT|STREAM_SCOPES)=/d' "${BOOT_DIR}/config.cfg" > "$CONFIG_TMP"
  chmod 600 "$CONFIG_TMP"
  mv "$CONFIG_TMP" "${BOOT_DIR}/config.cfg"
  trap - EXIT
fi
chmod 600 "${BOOT_DIR}/config.cfg"

base64 -d > "${BOOT_DIR}/health.cron" <<'B64_CRON'
Ki81ICogKiAqICogL2V0Yy9yYy5kL3JjLmNyb3dkc2VjLXVucmFpZC1ib3VuY2VyIGhlYWx0aCA+
L2Rldi9udWxsIDI+JjEK
B64_CRON
chmod 600 "${BOOT_DIR}/health.cron"
/usr/local/sbin/update_cron >/dev/null 2>&1 || true

command -v logger >/dev/null 2>&1 && logger -t "$NAME" "Installed plugin"
/etc/rc.d/rc.crowdsec-unraid-bouncer restart || true
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set -eu

NAME="crowdsec-unraid-bouncer"
BOOT_DIR="/boot/config/plugins/${NAME}"

if [ -x /etc/rc.d/rc.crowdsec-unraid-bouncer ]; then
  /etc/rc.d/rc.crowdsec-unraid-bouncer stop || true
fi

rm -f /usr/local/sbin/crowdsec-unraid-bouncer
rm -f /etc/rc.d/rc.crowdsec-unraid-bouncer
rm -rf /usr/local/emhttp/plugins/crowdsec-unraid-bouncer
rm -rf /var/run/crowdsec-unraid-bouncer
rm -f "${BOOT_DIR}/health.cron"
/usr/local/sbin/update_cron >/dev/null 2>&1 || true

command -v logger >/dev/null 2>&1 && logger -t "$NAME" "Removed runtime files and firewall state; persistent configuration was kept"
]]></INLINE>
</FILE>

</PLUGIN>
