<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "crowdsec-unraid-bouncer">
<!ENTITY author    "Railline">
<!ENTITY version   "2026.05.11.10">
<!ENTITY pluginURL "https://raw.githubusercontent.com/Railline/unraid-community-apps/main/plugins/crowdsec-unraid-bouncer.plg">
<!ENTITY support   "https://github.com/Railline/unraid-community-apps/issues">
]>

<PLUGIN name="&name;" author="&author;" version="&version;" pluginURL="&pluginURL;" support="&support;" min="6.9.0" icon="crowdsec-unraid-bouncer.png">

<CHANGES>
## crowdsec-unraid-bouncer

### 2026.05.11.8
- Add periodic full stream sync to self-heal missed LAPI deltas.

### 2026.05.11.7
- Avoid noisy ipset create messages on existing sets.

### 2026.05.11.6
- Load Global shield through a temporary ipset and swap it into place.
- Quietly ignore IPv6 stream decisions until an IPv6 backend is added.

### 2026.05.11.5
- Clean direct DROP rules when the ipset backend is active.
- Increase ipset max entries for Global shield.

### 2026.05.11.4
- Use batched ipset restore for large Global shield updates.

### 2026.05.11.3
- Add v3 protection modes: Essential shield, Global shield, and Custom origins.
- Add firewall backend selector: auto, iptables direct, ipset.
- Add ipset backend support with a clean refusal when ipset is unavailable.

### 2026.05.11.2
- Switch to real CrowdSec Local API bouncer stream mode.
- Add LAPI URL/API key/origin filters in the Unraid web UI.
- Add safety guard for direct iptables rule count.

### 2026.05.11
- Initial release.
- Sync CrowdSec IP decisions into an Unraid-safe iptables chain.
- Protect both host INPUT traffic and Docker-published ports through DOCKER-USER.
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
set -e

NAME="crowdsec-unraid-bouncer"
BOOT_DIR="/boot/config/plugins/${NAME}"
WEB_DIR="/usr/local/emhttp/plugins/${NAME}"

mkdir -p "${BOOT_DIR}" "${WEB_DIR}/include" /usr/local/sbin /etc/rc.d

# Install ipset when it is not present. Global protection depends on ipset
# because CrowdSec CAPI/lists can contain tens of thousands of decisions.
if ! command -v ipset >/dev/null 2>&1; then
  mkdir -p "${BOOT_DIR}/packages"
  IPSET_PKG="${BOOT_DIR}/packages/ipset-7.15-x86_64-1.txz"
  IPSET_URL="https://raw.githubusercontent.com/Railline/unraid-community-apps/main/packages/ipset-7.15-x86_64-1.txz"
  IPSET_MD5="93508b1dd170d56d71b41116359a45ff"
  if [ ! -f "$IPSET_PKG" ]; then
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "$IPSET_URL" -o "$IPSET_PKG"
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$IPSET_PKG" "$IPSET_URL"
    else
      echo "ipset is missing and neither curl nor wget is available" >&2
      exit 1
    fi
  fi
  if [ "$(md5sum "$IPSET_PKG" | awk '{print $1}')" != "$IPSET_MD5" ]; then
    echo "ipset package checksum mismatch: $IPSET_PKG" >&2
    exit 1
  fi
  installpkg "$IPSET_PKG"
fi

base64 -d > /usr/local/sbin/crowdsec-unraid-bouncer <<'B64_BIN'
