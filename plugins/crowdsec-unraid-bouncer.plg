B64_PHP

if [ ! -f "${BOOT_DIR}/config.cfg" ]; then
  cat > "${BOOT_DIR}/config.cfg" <<'CFG'
ENABLED="yes"
CS_CONTAINER="crowdsec"
LAPI_URL="http://127.0.0.1:8082"
API_KEY=""
CS_CHAIN="CROWDSEC"
IPTABLES_CHAINS="INPUT DOCKER-USER"
UPDATE_INTERVAL="10"
FULL_SYNC_INTERVAL="900"
DECISION_LIMIT="1000000"
LOG_LEVEL="info"
SKIP_PRIVATE_IPV4="yes"
STREAM_SCOPES="Ip,Range"
STREAM_ORIGINS="crowdsec,cscli"
MAX_DIRECT_RULES="5000"
PROTECTION_MODE="essential"
FIREWALL_BACKEND="auto"
IPSET_NAME="crowdsec4"
LAPI_STREAM_TIMEOUT="300"
NOTIFY_ENABLED="yes"
NOTIFY_UNRAID="yes"
NOTIFY_TELEGRAM="yes"
NOTIFY_COOLDOWN="1800"
TELEGRAM_HTTP_CONFIG="/mnt/cache/appdata/crowdsec/notifications/http.yaml"
HEALTH_MIN_IPSET_ENTRIES="1"
HEALTH_MAX_SYNC_AGE="900"

CFG
fi


cat > "${BOOT_DIR}/health.cron" <<'CRON'
*/5 * * * * /etc/rc.d/rc.crowdsec-unraid-bouncer health >/dev/null 2>&1
CRON
chmod 600 "${BOOT_DIR}/health.cron"
/usr/local/sbin/update_cron >/dev/null 2>&1 || true

if command -v logger >/dev/null 2>&1; then
  logger -t crowdsec-unraid-bouncer "Installed plugin"
fi

/etc/rc.d/rc.crowdsec-unraid-bouncer restart || true
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
set -e

if [ -x /etc/rc.d/rc.crowdsec-unraid-bouncer ]; then
  /etc/rc.d/rc.crowdsec-unraid-bouncer stop || true
fi

rm -f /usr/local/sbin/crowdsec-unraid-bouncer
rm -f /etc/rc.d/rc.crowdsec-unraid-bouncer
rm -rf /usr/local/emhttp/plugins/crowdsec-unraid-bouncer
rm -rf /var/run/crowdsec-unraid-bouncer

if command -v logger >/dev/null 2>&1; then
  logger -t crowdsec-unraid-bouncer "Removed plugin runtime files; persistent config kept in /boot/config/plugins/crowdsec-unraid-bouncer"
fi
]]></INLINE>
</FILE>

</PLUGIN>

